{
  "$schema": "https://raw.githubusercontent.com/nicepage/nicepage/gh-pages/schemas/ent.json",
  "productName": "Syncthing Conflict Resolver",
  "version": "2.0.0",
  "identifier": "com.syncthing.conflict-resolver",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Syncthing Conflict Resolver",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
