{
  "name": "syncthing-conflict-cli",
  "version": "0.1.0",
  "description": "CLI tool to scan, interactively resolve, and auto-handle Syncthing sync conflict files",
  "type": "module",
  "bin": {
    "stc": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "syncthing",
    "conflict",
    "cli",
    "merge"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "inquirer": "^13.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/diff": "^8.0.0",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
